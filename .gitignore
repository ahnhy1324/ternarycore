# Actual-model captures are included in the external handoff ZIP, not Git.
# The deterministic runner and compact CSV/JSON results remain tracked.
analysis/kv_validation/real_model/runs/*/tensors/*.pt
analysis/kv_validation/real_model/end_to_end_injection/*/*/captures/*.pt
analysis/kv_validation/real_model/end_to_end_injection/*/*/final_hidden.pt
analysis/kv_validation/real_model/end_to_end_injection/*/*/last_token_logits.npy

# Preserve raw text reports for the final timing-driven Vivado sweep.
!analysis/kv_validation/hardware_estimates/vivado_synth_2026_1_timed/
!analysis/kv_validation/hardware_estimates/vivado_synth_2026_1_timed/*.rpt

# Track compact, reproducible summaries from the v0.2 comparison. Raw Vivado
# reports/checkpoints stay in the external handoff ZIP and remain ignored.
!analysis/kv_validation/hardware_estimates/vivado_qk_core_2026_1/
analysis/kv_validation/hardware_estimates/vivado_qk_core_2026_1/*
!analysis/kv_validation/hardware_estimates/vivado_qk_core_2026_1/summary.csv
!analysis/kv_validation/hardware_estimates/vivado_qk_core_2026_1/summary.json
